    <encodingDesc>
      <appInfo>
        <application ident="RomaJS" version="1.1.0" when="2024-06-28T00:00:16.741Z">
          <desc>初期の要素選択は <ref target="https://github.com/TEIC/romajs">RomaJS</ref> で編集した。</desc>
        </application>
