    <revisionDesc status="published">
      <change when="2026-08-11" who="#snakamura">記述を日本語化。<gi>lg</gi> と <gi>l</gi> の
        <att>include</att> 指定を verse から core へ修正し (両要素は core モジュール所属のため、
        verse 側に書いても取り込まれずスキーマから欠落していた)、<att>rhyme</att> のために
        verse モジュールを参照。あわせて Schematron 制約を <gi>constraintSpec</gi> として追加。</change>
      <change when="2024-06-28" who="#snakamura">pb 要素の facs 属性、facsimile 要素の対応。</change>
    </revisionDesc>
  </teiHeader>
  <text>
    <body>
      <head>校異源氏物語 TEI カスタマイズ</head>

      <p>池田亀鑑『校異源氏物語』(中央公論社) を底本とする
        <ref target="https://kouigenjimonogatari.github.io/">校異源氏物語テキストデータベース</ref>
        のためのカスタマイズである。全54帖の TEI ファイル (<code>xml/master/*.xml</code>) は、
        この ODD から生成した RELAX NG と Schematron の両方で検証される。</p>

      <p>採用した符号化の方針は次のとおり。
        <list rend="numbered">
          <item>本文は <gi>seg</gi> の連なりとして表し、各 <gi>seg</gi> は
            <att>corresp</att> で API 上の該当箇所 (<code>w3id.org/kouigenjimonogatari</code>) を指す。</item>
          <item>和歌は <gi>lg</gi> (<att>type</att> は <code>waka</code>) とし、
            5句をそれぞれ <gi>l</gi> として <att>n</att> に句番号を与える。</item>
          <item>底本のページ番号は <gi>pb</gi> で示し、<att>corresp</att> で
            <gi>facsimile</gi> 内の <gi>zone</gi> を、<att>facs</att> で IIIF 画像を指す。</item>
          <item>底本の画像は国立国会図書館デジタルコレクションの IIIF を
            <gi>facsimile</gi> / <gi>surface</gi> / <gi>zone</gi> で参照する。</item>
        </list>
      </p>

      <p>スキーマだけでは表せない規則 (和歌は5句である、文書内の参照が解決する、など) は
        <gi>constraintSpec</gi> として ODD に直接書いてある。この ODD が唯一の正本であり、
        <code>docs/schema/tei_kouigenji.rng</code> と <code>docs/schema/tei_kouigenji.sch</code> は
        <code>scripts/build-schema.zsh</code> で生成する。</p>

      <schemaSpec ident="tei_kouigenji" start="TEI" prefix="tei_" targetLang="ja" docLang="ja">

        <!-- Schematron 制約の既定。queryBinding を書かないと eq / cast as などが使えない -->
        <constraintDecl scheme="schematron" queryBinding="xslt2">
          <sch:ns prefix="xs" uri="http://www.w3.org/2001/XMLSchema"/>
        </constraintDecl>

        <!-- ヘッダ -->
        <moduleRef key="header" include="teiHeader fileDesc titleStmt publicationStmt sourceDesc revisionDesc change encodingDesc distributor availability"/>

        <!-- core。lg / l は verse ではなく core モジュールに属する。
             verse 側の include に書いても黙って無視され、和歌がスキーマから丸ごと欠落する。 -->
        <moduleRef key="core" include="p title lb date respStmt bibl author ref pb resp name graphic publisher lg l"/>

        <!-- 文書構造 -->
        <moduleRef key="textstructure" include="TEI text body div"/>

        <!-- 多くのクラスを実体化するため、tei モジュールは全体を参照する -->
        <moduleRef key="tei"/>

        <moduleRef key="linking" include="seg standOff"/>
        <moduleRef key="transcr" include="facsimile surface zone"/>
        <moduleRef key="namesdates" include="persName placeName"/>
        <moduleRef key="analysis" include="s"/>

        <!-- verse からは要素を1つも採らない。lg/@rhyme が属する
             att.metrical を取り込むためだけに参照する。 -->
        <moduleRef key="verse" except="caesura metDecl metSym rhyme"/>

        <!-- ============================================================
             和歌
             ============================================================ -->
        <!--
          文法で書けるものは文法に置く。@xml:id の必須化と @rhyme の値の限定は
          RELAX NG で表せるので、ここで宣言する。追加のツールなしに、どのエディタでも
          その場で検出される。
          一方「和歌は5句」は Schematron に残してある。content model でも書ける
          （句の間に model.global を挟めば lg の中に <pb/> や <lb/> も置ける）が、
          文法は「5個ちょうど」以上のことを言えず、違反したときのメッセージも
          「lg incomplete」止まりで、どの和歌が何句なのかを教えてくれない。
          count(tei:l) eq 5 なら「waka-001 は 4 句」と名指しできる。
        -->
        <elementSpec ident="lg" module="core" mode="change">
          <constraintSpec ident="waka-line-count" scheme="schematron">
            <desc xml:lang="ja">和歌は5句からなる。</desc>
            <desc xml:lang="en">A waka consists of exactly five lines.</desc>
            <constraint>
              <sch:rule context="tei:lg[ @type eq 'waka' ]">
                <sch:let name="lines" value="count( tei:l )"/>
                <sch:assert test="$lines eq 5" role="error"
                  >和歌は5句です (<sch:value-of select="@xml:id"/> は <sch:value-of select="$lines"/> 句)
                  / A waka must have 5 lines (<sch:value-of select="@xml:id"/> has <sch:value-of
                    select="$lines"/>)</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList>
            <!-- att.global は ident="xml:id"（@ns なし）で宣言されている。
                 ident="id" + ns="…/XML/1998/namespace" と書くと既存の属性に
                 一致せず、黙って無視される。 -->
            <attDef ident="xml:id" mode="change" usage="req">
              <desc xml:lang="ja">和歌は API から参照されるため必須とする。</desc>
              <desc xml:lang="en">Required: the API refers to each waka by this identifier.</desc>
            </attDef>
            <!-- @type は必須かつ waka に限定する。上の Schematron 2本は
                 context="tei:lg[@type eq 'waka']" なので、@type を書き忘れたり
                 綴りを間違えたりすると、どちらも無言で検査対象から外れてしまう。
                 文法で @type を縛ることが、Schematron が働く前提になっている。 -->
            <attDef ident="type" mode="change" usage="req">
              <desc xml:lang="ja">本データベースの lg は和歌のみ。</desc>
              <desc xml:lang="en">The only kind of lg in this database is a waka.</desc>
              <valList type="closed">
                <valItem ident="waka">
                  <desc xml:lang="ja">和歌</desc>
                  <desc xml:lang="en">waka</desc>
                </valItem>
              </valList>
            </attDef>
            <attDef ident="rhyme" mode="change" usage="req">
              <desc xml:lang="ja">本データベースの和歌はすべて短歌である。</desc>
              <desc xml:lang="en">All waka in this database are tanka.</desc>
              <valList type="closed">
                <valItem ident="tanka">
                  <desc xml:lang="ja">短歌（5句31音）</desc>
                  <desc xml:lang="en">tanka (five lines)</desc>
                </valItem>
              </valList>
            </attDef>
          </attList>
          <exemplum xml:lang="ja">
            <p>第1帖「きりつぼ」の第一首（実データでは <ident>waka-001</ident>。用例では xml:id の重複を避けて <ident>waka-000</ident> としている）。桐壺更衣の辞世の歌。
              和歌は本文中の <gi>seg</gi> の内側に置き、直前の全角空白2文字で字下げを表す。</p>
            <egXML xmlns="http://www.tei-c.org/ns/Examples"><seg corresp="https://w3id.org/kouigenjimonogatari/api/items/0009-03.json">　　<lg xml:id="waka-000b" type="waka" rhyme="tanka"><l n="1">かきりとて</l><l n="2">わかるゝ道の</l><l n="3">かなしきに</l><l n="4">いかまほしきは</l><l n="5">いのちなりけり</l></lg>いとか</seg></egXML>
          </exemplum>
        </elementSpec>

        <elementSpec ident="l" module="core" mode="change">

          <constraintSpec ident="waka-line-numbering" scheme="schematron">
            <desc xml:lang="ja">句の @n は、その句が和歌の何句目かと一致する。</desc>
            <desc xml:lang="en">The @n of a line must match its position within the waka.</desc>
            <constraint>
              <sch:rule context="tei:lg[ @type eq 'waka' ]/tei:l">
                <sch:let name="pos" value="count( preceding-sibling::tei:l ) + 1"/>
                <sch:assert test="@n eq string( $pos )" role="error"
                  >この句の @n は <sch:value-of select="$pos"/> であるはずです (いまは "<sch:value-of
                    select="@n"/>")
                  / This line's @n should be <sch:value-of select="$pos"/> (found "<sch:value-of
                    select="@n"/>")</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <attList>
            <attDef ident="n" mode="change" usage="req">
              <desc xml:lang="ja">和歌の何句目かを示す。必須とする。</desc>
              <desc xml:lang="en">Required: the position of this line within the waka.</desc>
            </attDef>
          </attList>
          <exemplum xml:lang="ja">
            <p>句は5つ、<att>n</att> は 1 から 5 まで、和歌の中での位置と一致させる。
              位置と <att>n</att> のずれは Schematron が検出する。</p>
            <egXML xmlns="http://www.tei-c.org/ns/Examples"><lg xml:id="waka-000" type="waka" rhyme="tanka"><l n="1">かきりとて</l><l n="2">わかるゝ道の</l><l n="3">かなしきに</l><l n="4">いかまほしきは</l><l n="5">いのちなりけり</l></lg></egXML>
          </exemplum>
        </elementSpec>

        <!-- ============================================================
             ページと底本画像
             ============================================================ -->
        <elementSpec ident="pb" module="core" mode="change">
          <constraintSpec ident="pb-corresp-resolves" scheme="schematron">
            <desc xml:lang="ja">pb/@corresp は facsimile 内の zone を指していなければならない。</desc>
            <desc xml:lang="en">pb/@corresp must point to a zone inside the facsimile.</desc>
            <constraint>
              <!-- @corresp は空白区切りで複数の参照を書ける（att.global.linking の
                   データ型は teidata.pointer のリスト）。substring-after で切ると
                   複数値のときに壊れるので、トークンに分けて全件を検査する。
                   "#" で始まらない値も、ここで不合格になる。 -->
              <sch:rule context="tei:pb[ @corresp ]">
                <sch:assert
                  test="every $p in tokenize( normalize-space( @corresp ), '\s+' )
                        satisfies ( starts-with( $p, '#' )
                                    and //tei:zone[ @xml:id eq substring( $p, 2 ) ] )"
                  role="error"
                  >ページ <sch:value-of select="@n"/> の @corresp "<sch:value-of select="@corresp"
                  />" に、文書中の zone を指していない参照があります
                  / @corresp "<sch:value-of select="@corresp"/>" on page <sch:value-of select="@n"
                  /> contains a reference that does not resolve to a zone in this document</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>

          <constraintSpec ident="pb-monotonic" scheme="schematron">
            <desc xml:lang="ja">ページ番号は帖の中で単調に増加する。</desc>
            <desc xml:lang="en">Page numbers increase monotonically within a chapter.</desc>
            <constraint>
              <!--
                context で気をつける点が2つある。
                1. 直前の pb は「preceding::tei:pb[1]」ではなく
                   「preceding::tei:pb[@n][1]」で取る。@n を持たない pb が間に入ると
                   $prev が空になり、比較が偽になって黙って通過してしまう。
                2. xs:integer() は変換できない値で例外を投げ、その時点で
                   文書全体の検証が中断する（他の制約も検査されなくなる）。
                   ページ番号に数字以外の値を使う可能性を残すため、
                   castable な場合だけ比較する。
              -->
              <sch:rule context="tei:pb[ @n castable as xs:integer ]
                                 [ preceding::tei:pb[ @n ][1]/@n castable as xs:integer ]">
                <sch:let name="prev" value="preceding::tei:pb[ @n ][1]/@n"/>
                <sch:report test="xs:integer( @n ) le xs:integer( $prev )" role="error"
                  >ページ番号が逆行しています (前は <sch:value-of select="$prev"/>、いまは <sch:value-of
                    select="@n"/>)
                  / Page numbers go backwards (previous <sch:value-of select="$prev"/>, current
                  <sch:value-of select="@n"/>)</sch:report>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <!--
            上の2つの Schematron は、いずれも属性の存在を context の条件にしている
            （@corresp が無い pb、@n が無い pb は検査対象にならない）。
            属性そのものを文法で必須にしておかないと、書き忘れた瞬間に
            制約が黙って外れる。
          -->
          <attList>
            <attDef ident="corresp" mode="change" usage="req">
              <desc xml:lang="ja">対応する zone を指す。必須とする。</desc>
              <desc xml:lang="en">Required: points at the corresponding zone.</desc>
            </attDef>
            <attDef ident="n" mode="change" usage="req">
              <desc xml:lang="ja">底本のページ番号。必須とする。</desc>
              <desc xml:lang="en">Required: the page number in the source edition.</desc>
            </attDef>
            <attDef ident="facs" mode="change" usage="req">
              <desc xml:lang="ja">該当箇所の IIIF 画像を指す。必須とする。</desc>
              <desc xml:lang="en">Required: points at the IIIF image for this page.</desc>
            </attDef>
          </attList>
          <exemplum xml:lang="ja">
            <p>第1帖「きりつぼ」の5ページ目。<att>n</att> が底本のページ番号、<att>corresp</att> が
              同じ文書内の <gi>zone</gi>、<att>facs</att> が国立国会図書館デジタルコレクションの
              IIIF 画像（切り出し領域つき）を指す。<att>facs</att> の座標は、参照先 <gi>zone</gi> の
              <att>ulx</att>/<att>uly</att>/幅/高さと一致する。</p>
            <egXML xmlns="http://www.tei-c.org/ns/Examples"><pb n="5" corresp="#zone_0005" facs="https://dl.ndl.go.jp/api/iiif/3437686/R0000022/0,0,3445,4706/full/0/default.jpg"/></egXML>
          </exemplum>
          <exemplum xml:lang="ja">
            <p>対応する <gi>zone</gi> は <gi>facsimile</gi> の中にある。1つの見開き
              （<gi>surface</gi>）には通常、右半・左半にあたる2つの <gi>zone</gi> が入り、
              <gi>pb</gi> はその一方を指す。ただし各帖の最初と最後の見開きは片側だけを収めるため、
              <gi>zone</gi> が1つのこともある（全949面のうち86面）。下の <ident>f001</ident> がその例。</p>
            <egXML xmlns="http://www.tei-c.org/ns/Examples"><surface xml:id="f001" ulx="0" uly="0" lrx="6890" lry="4706" sameAs="https://dl.ndl.go.jp/api/iiif/3437686/canvas/22">
  <graphic width="6890px" height="4706px" sameAs="https://dl.ndl.go.jp/api/iiif/3437686/R0000022" url="https://dl.ndl.go.jp/api/iiif/3437686/R0000022/full/full/0/default.jpg"/>
  <zone xml:id="zone_0005" ulx="0" uly="0" lrx="3445" lry="4706"/>
</surface></egXML>
          </exemplum>
        </elementSpec>

        <!-- ============================================================
             本文断片
             ============================================================ -->
        <!-- URI の書式は datatype の制限で表せるので、Schematron ではなく文法で縛る -->
        <elementSpec ident="seg" module="linking" mode="change">
          <attList>
            <attDef ident="corresp" mode="change" usage="req">
              <desc xml:lang="ja">本データベースの API 上の該当箇所を指す。必須とする。</desc>
              <desc xml:lang="en">Required: points at the corresponding item in this database's API.</desc>
              <!--
                maxOccurs="unbounded" を書かないと既定の 1 が効き、TEI 本来の
                「teidata.pointer のリスト」が単一値に縮む（空白区切りで複数書けなくなる）。
                また dataRef を key="teidata.pointer" にすると @restriction が
                黙って捨てられ、URI の書式制限が丸ごと消える。@restriction は
                @name と組み合わせたときだけ効く。
              -->
              <datatype maxOccurs="unbounded">
                <dataRef name="anyURI"
                         restriction="https://w3id\.org/kouigenjimonogatari/api/items/\d{4}-\d{2}\.json"/>
              </datatype>
            </attDef>
          </attList>
          <exemplum xml:lang="ja">
            <p>本文の冒頭。底本の1行が1つの <gi>seg</gi> にあたり、<att>corresp</att> の URI は
              <code>items/&lt;ページ番号4桁&gt;-&lt;行2桁&gt;.json</code> の形をとる。
              下の例は5ページ目の1行目。<gi>lb</gi> は各行の開始を示す。</p>
            <egXML xmlns="http://www.tei-c.org/ns/Examples"><lb/><seg corresp="https://w3id.org/kouigenjimonogatari/api/items/0005-01.json">いつれの御時にか女御更衣あまたさふらひ給けるなかにいとやむことなきゝは</seg></egXML>
          </exemplum>
        </elementSpec>

        <!-- ============================================================
             改訂記録
             ============================================================ -->
        <elementSpec ident="change" module="header" mode="change">
          <constraintSpec ident="change-who-resolves" scheme="schematron">
            <desc xml:lang="ja">change/@who は teiHeader 中の respStmt を指す。</desc>
            <desc xml:lang="en">change/@who must point to a respStmt in the teiHeader.</desc>
            <constraint>
              <!-- @who も空白区切りで複数書ける。また「文書中のどこかに同じ xml:id がある」
                   だけでは弱く、和歌の xml:id を指していても通ってしまうので、
                   teiHeader 中の respStmt に限定する。 -->
              <sch:rule context="tei:change[ @who ]">
                <sch:assert
                  test="every $p in tokenize( normalize-space( @who ), '\s+' )
                        satisfies ( starts-with( $p, '#' )
                                    and //tei:teiHeader//tei:respStmt[ @xml:id eq substring( $p, 2 ) ] )"
                  role="error"
                  >改訂記録の @who "<sch:value-of select="@who"/>" に、teiHeader の respStmt を
                  指していない参照があります
                  / change/@who "<sch:value-of select="@who"/>" contains a reference that does not
                  resolve to a respStmt in the teiHeader</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>
          <exemplum xml:lang="ja">
            <p><att>who</att> は同じ <gi>teiHeader</gi> にある <gi>respStmt</gi> の
              <att>xml:id</att> を指す。指し先が無い場合は Schematron が検出する。</p>
            <egXML xmlns="http://www.tei-c.org/ns/Examples"><teiHeader>
  <fileDesc>
    <titleStmt>
      <title>校異源氏物語・きりつぼ</title>
      <author>池田亀鑑</author>
      <respStmt xml:id="encoder">
        <resp when="2020-08-22">TEI Encoding</resp>
        <name>Satoru Nakamura</name>
      </respStmt>
    </titleStmt>
  </fileDesc>
  <revisionDesc status="published">
    <change when="2024-06-28" who="#encoder">pb要素のfacs属性を修正しました。facsimile要素を修正しました。</change>
  </revisionDesc>
</teiHeader></egXML>
          </exemplum>
        </elementSpec>

      </schemaSpec>
    </body>
  </text>
</TEI>
